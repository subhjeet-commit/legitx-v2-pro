<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Avoid machine-wide fallback folders (e.g. VS Shared\NuGetPackages) that may not exist on clean SDK-only installs. -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
