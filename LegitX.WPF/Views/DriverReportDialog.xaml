<Window x:Class="LegitX.WPF.Views.DriverReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Driver Health Report"
        Width="520" Height="580"
        MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource InterFont}"
        ShowInTaskbar="False">

    <Border Background="#FF0F0F18" CornerRadius="16"
            BorderBrush="#FF2A2A40" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Title bar -->
                <RowDefinition Height="Auto"/>  <!-- Accent line -->
                <RowDefinition Height="*"/>     <!-- Content -->
                <RowDefinition Height="Auto"/>  <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    Padding="20,14,14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Border Width="32" Height="32" CornerRadius="8" Background="#15EF4444" Margin="0,0,12,0">
                        <Path Data="M6,0 A6,6 0 1,0 6,12 A6,6 0 1,0 6,0 M6,2.5 L6,7 M6,9 L6,9.5"
                              Stroke="#FFEF4444" StrokeThickness="1.5" Fill="Transparent"
                              Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Driver Health Report" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="SubtitleText" Text="Scanning drivers..." FontSize="10.5"
                                   Foreground="#FF52525b" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Click="CloseBtn_Click" Cursor="Hand"
                            Width="32" Height="32" ToolTip="Close">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="6">
                                                <Path Data="M2,2 L10,10 M10,2 L2,10" Stroke="#FF52525b"
                                                      StrokeThickness="1.5" HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#15FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Accent line -->
            <Border Grid.Row="1" Height="1" Margin="20,0" Background="#FF2A2A40"/>

            <!-- Content -->
            <Grid Grid.Row="2">
                <!-- Loading overlay -->
                <Grid x:Name="LoadingOverlay" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Spinning ring -->
                        <Grid Width="48" Height="48" Margin="0,0,0,16" HorizontalAlignment="Center">
                            <Ellipse Width="48" Height="48" Stroke="#FF2A2A40" StrokeThickness="3"/>
                            <Ellipse x:Name="SpinnerRing" Width="48" Height="48"
                                     Stroke="#FFEF4444" StrokeThickness="3"
                                     StrokeDashArray="2,6" StrokeDashCap="Round"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="Scanning system drivers..." FontSize="13" FontWeight="Medium"
                                   Foreground="#FFa1a1aa" HorizontalAlignment="Center"/>
                        <TextBlock Text="This may take a few seconds" FontSize="11"
                                   Foreground="#FF52525b" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Driver list -->
                <ScrollViewer x:Name="DriverContent" VerticalScrollBarVisibility="Auto"
                              Padding="20,14" Visibility="Collapsed">
                    <StackPanel x:Name="DriverList"/>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="3" Padding="20,12" Background="#08FFFFFF" CornerRadius="0,0,16,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="OverallStatusDot" Width="8" Height="8" Fill="#FFF59E0B" Margin="0,0,8,0"/>
                        <TextBlock x:Name="OverallStatusText" Text="Scanning..."
                                   FontSize="11.5" Foreground="#FF71717a" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Click="CloseBtn_Click" Cursor="Hand"
                            Padding="16,8" FontSize="12" FontWeight="SemiBold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FF161622"/>
                                <Setter Property="Foreground" Value="#FFe4e4e7"/>
                                <Setter Property="BorderBrush" Value="#FF2A2A40"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="Close" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FF1C1C2E"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF353550"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
