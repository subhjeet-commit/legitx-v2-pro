<Window x:Class="LegitX.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LegitX.WPF.ViewModels"
        xmlns:conv="clr-namespace:LegitX.WPF.Converters"
        xmlns:ctrl="clr-namespace:LegitX.WPF.Controls"
        Title="LegitX V2"
        Icon="/Assets/app.ico"
        Width="560" Height="740"
        MinWidth="500" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource InterFont}">

    <!-- DataContext set in code-behind for robust error handling -->

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:InverseBoolConverter x:Key="InvBool"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <conv:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
        <QuadraticEase x:Key="EaseInOut" EasingMode="EaseInOut"/>
    </Window.Resources>

    <!-- ═══════════════ OUTER SHELL WITH SHADOW ═══════════════ -->
    <Border Background="{DynamicResource BgBrush}" CornerRadius="16"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Title bar -->
                <RowDefinition Height="Auto"/>  <!-- Accent line -->
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="Auto"/>  <!-- Tab bar -->
                <RowDefinition Height="*"/>     <!-- Content -->
                <RowDefinition Height="Auto"/>  <!-- Status bar -->
            </Grid.RowDefinitions>

            <!-- ╔══════════════════════════════════════════════════╗
                 ║              CUSTOM TITLE BAR                     ║
                 ╚══════════════════════════════════════════════════╝ -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    Padding="16,10,10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Drag area -->
                    <TextBlock Grid.Column="0" Text="LegitX V2" FontSize="11" Foreground="#FF52525b"
                               VerticalAlignment="Center" FontWeight="Medium"/>

                    <!-- Window Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Logged-in user + Logout -->
                        <Border Background="#08FFFFFF" CornerRadius="6" Padding="8,4" Margin="0,0,6,0"
                                VerticalAlignment="Center" Cursor="Hand"
                                MouseLeftButtonDown="LogoutBtn_Click" ToolTip="Click to logout">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z"
                                      Fill="#FF52525b" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"
                                      Margin="0,0,5,0"/>
                                <TextBlock x:Name="LoggedInUser" Text="" FontSize="10" Foreground="#FF71717a"
                                           VerticalAlignment="Center"/>
                                <!-- Logout icon -->
                                <Path Data="M10,9 L15,12 L10,15 Z M3,3 L3,21 L13,21 L13,18 L6,18 L6,6 L13,6 L13,3 Z"
                                      Fill="#FF52525b" Width="10" Height="10" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource IconBtn}" Click="MinimizeBtn_Click"
                                Width="32" Height="32" ToolTip="Minimize">
                            <Path Data="M4,0 L12,0" Stroke="#FF52525b" StrokeThickness="1.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="CloseBtn" Style="{StaticResource IconBtn}" Click="CloseBtn_Click"
                                Width="32" Height="32" ToolTip="Close">
                            <Path Data="M2,2 L10,10 M10,2 L2,10" Stroke="#FF52525b" StrokeThickness="1.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Accent gradient line ── -->
            <Border Grid.Row="1" Height="2" Margin="16,0">
                <Border.Effect>
                    <DropShadowEffect Color="#FFEF4444" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/>
                </Border.Effect>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00EF4444" Offset="0"/>
                        <GradientStop Color="#FFEF4444" Offset="0.3"/>
                        <GradientStop Color="#FFFF6B6B" Offset="0.5"/>
                        <GradientStop Color="#FFEF4444" Offset="0.7"/>
                        <GradientStop Color="#00EF4444" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- ╔══════════════════════════════════════════════════╗
                 ║                  HEADER BANNER                    ║
                 ╚══════════════════════════════════════════════════╝ -->
            <Border Grid.Row="2" Padding="20,14,20,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#06EF4444" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo + Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- App logo -->
                        <Border Width="42" Height="42" CornerRadius="12" Margin="0,0,14,0"
                                Background="#10FFFFFF" ClipToBounds="True"
                                BorderBrush="#18EF4444" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#FFEF4444" BlurRadius="12" ShadowDepth="0" Opacity="0.15"/>
                            </Border.Effect>
                            <Image Source="/Assets/logo.png" Width="36" Height="36"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="LegitX" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text=" V2" FontSize="20" FontWeight="Light"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                            <TextBlock Text="Precision Mouse Control" FontSize="11"
                                       Foreground="#FF52525b" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Quick action buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconBtn}" ToolTip="Save All Settings"
                                Command="{Binding SaveCommand}">
                            <Path Data="M3,1 L3,5 L9,5 L9,1 M2,0 L10,0 L12,2 L12,12 L0,12 L0,0 Z M4,8 L8,8 L8,12 L4,12 Z"
                                  Fill="#FF71717a" Stroke="#FF71717a" StrokeThickness="0.3"
                                  Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" ToolTip="Reset to Defaults"
                                Command="{Binding ResetCommand}">
                            <Path Data="M1,6 A5,5 0 1 1 6,11 M1,6 L1,2 M1,6 L5,6"
                                  Stroke="#FF71717a" StrokeThickness="1.5" Fill="Transparent"
                                  Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ╔══════════════════════════════════════════════════╗
                 ║                 TAB BAR                           ║
                 ╚══════════════════════════════════════════════════╝ -->
            <Border Grid.Row="3" Padding="16,0,16,4">
                <Border Background="#08FFFFFF" CornerRadius="12" Padding="4">
                    <TabControl x:Name="MainTabs" SelectedIndex="{Binding SelectedTab}"
                                Background="Transparent" BorderThickness="0"
                                TabStripPlacement="Top">

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <Path Data="M6,0 A6,6 0 1,0 6,12 A6,6 0 1,0 6,0 M6,2 L6,6 L9,6"
                                          Stroke="{StaticResource AccentBrush}" StrokeThickness="1.3" Fill="Transparent"
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sensitivity" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M6,0 L7.5,4 L12,4 L8.5,7 L10,12 L6,9 L2,12 L3.5,7 L0,4 L4.5,4 Z"
                                          Stroke="#FF71717a" StrokeThickness="0.8" Fill="#FF71717a"
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Advanced" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M5,0 L7,0 L7,4 L11,4 L11,6 L7,6 L7,12 L5,12 L5,6 L1,6 L1,4 L5,4 Z"
                                          Fill="{StaticResource OrangeBrush}" Width="12" Height="12"
                                          Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="45"/>
                                        </Path.RenderTransform>
                                    </Path>
                                    <TextBlock Text="Optimize" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M6,0 L7.2,4.2 L12,4.2 L8,7 L9.5,12 L6,9 L2.5,12 L4,7 L0,4.2 L4.8,4.2 Z"
                                          Fill="{StaticResource PurpleBrush}" Width="13" Height="13"
                                          Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Extras" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M6,0 A6,6 0 1,0 6,12 A6,6 0 1,0 6,0 M6,3 A3,3 0 1,0 6,9 A3,3 0 1,0 6,3 M6,0 L6,-2 M6,12 L6,14 M0,6 L-2,6 M12,6 L14,6"
                                          Stroke="#FF71717a" StrokeThickness="1.1" Fill="Transparent"
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Settings" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                        </TabItem>
                    </TabControl>
                </Border>
            </Border>

            <!-- ╔══════════════════════════════════════════════════╗
                 ║               CONTENT AREA                        ║
                 ╚══════════════════════════════════════════════════╝ -->
            <Grid Grid.Row="4">
                <!-- Tab 0: SENSITIVITY -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,10"
                              Visibility="{Binding SelectedTab, Converter={StaticResource BoolVis}, ConverterParameter=0}">
                    <StackPanel>
                        <!-- ══ VELOCITY CURVE GRAPH ══ -->
                        <Border Style="{StaticResource CardPanelAccent}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Path Data="M2,12 L5,4 L8,8 L11,2 L14,6"
                                          Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"
                                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="VELOCITY CURVE" Style="{StaticResource SectionTitle}" Margin="0"/>
                                </StackPanel>

                                <!-- Live Graph -->
                                <Border Background="#FF0A0A12" CornerRadius="10" Padding="0" Margin="0,0,0,10"
                                        BorderBrush="#FF1A1A28" BorderThickness="1" ClipToBounds="True"
                                        Height="210">
                                    <Grid>
                                        <!-- Deep corner ambient glow (bottom-left red) -->
                                        <Border CornerRadius="10" Opacity="0.5">
                                            <Border.Background>
                                                <RadialGradientBrush Center="0.1,0.9" GradientOrigin="0.1,0.9" RadiusX="0.6" RadiusY="0.6">
                                                    <GradientStop Color="#14EF4444" Offset="0"/>
                                                    <GradientStop Color="#00000000" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <!-- Top-right subtle accent glow -->
                                        <Border CornerRadius="10" Opacity="0.25">
                                            <Border.Background>
                                                <RadialGradientBrush Center="0.9,0.1" GradientOrigin="0.9,0.1" RadiusX="0.5" RadiusY="0.5">
                                                    <GradientStop Color="#10FF9999" Offset="0"/>
                                                    <GradientStop Color="#00000000" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- Y-axis label -->
                                        <TextBlock Text="OUTPUT" Foreground="#FF2E2E42" FontSize="8"
                                                   FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                                   VerticalAlignment="Top" HorizontalAlignment="Left"
                                                   Margin="10,8,0,0"/>
                                        <!-- X-axis label -->
                                        <TextBlock Text="INPUT SPEED" Foreground="#FF2E2E42" FontSize="8"
                                                   FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                                   VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                   Margin="0,0,10,6"/>

                                        <!-- Curve Type badge (pill shape) -->
                                        <Border Background="#14EF4444" CornerRadius="8" Padding="8,3"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0">
                                            <TextBlock Text="{Binding CurveTypeName}" Foreground="#FFEF4444" FontSize="9"
                                                       FontWeight="Bold" FontFamily="{StaticResource MonoFont}"/>
                                        </Border>

                                        <!-- The actual graph (Viewbox scales the 400×200 canvas to fill) -->
                                        <Viewbox Stretch="Fill" Margin="10,22,10,24">
                                            <Canvas Width="400" Height="200" ClipToBounds="True">
                                                <!-- Grid lines — horizontal (5 lines) -->
                                                <Line X1="0" Y1="0"   X2="400" Y2="0"   Stroke="#FF161624" StrokeThickness="1"/>
                                                <Line X1="0" Y1="50"  X2="400" Y2="50"  Stroke="#FF161624" StrokeThickness="0.5" StrokeDashArray="6,4"/>
                                                <Line X1="0" Y1="100" X2="400" Y2="100" Stroke="#FF161624" StrokeThickness="0.5" StrokeDashArray="6,4"/>
                                                <Line X1="0" Y1="150" X2="400" Y2="150" Stroke="#FF161624" StrokeThickness="0.5" StrokeDashArray="6,4"/>
                                                <Line X1="0" Y1="200" X2="400" Y2="200" Stroke="#FF161624" StrokeThickness="1"/>
                                                <!-- Grid lines — vertical (5 lines) -->
                                                <Line X1="0"   Y1="0" X2="0"   Y2="200" Stroke="#FF161624" StrokeThickness="1"/>
                                                <Line X1="100" Y1="0" X2="100" Y2="200" Stroke="#FF161624" StrokeThickness="0.5" StrokeDashArray="6,4"/>
                                                <Line X1="200" Y1="0" X2="200" Y2="200" Stroke="#FF161624" StrokeThickness="0.5" StrokeDashArray="6,4"/>
                                                <Line X1="300" Y1="0" X2="300" Y2="200" Stroke="#FF161624" StrokeThickness="0.5" StrokeDashArray="6,4"/>
                                                <Line X1="400" Y1="0" X2="400" Y2="200" Stroke="#FF161624" StrokeThickness="1"/>

                                                <!-- Diagonal reference line (1:1 ratio guide) -->
                                                <Line X1="0" Y1="200" X2="400" Y2="0" Stroke="#FF1C1C2E" StrokeThickness="0.7" StrokeDashArray="4,6"/>

                                                <!-- Filled area under the curve (gradient fade) -->
                                                <Polygon Points="{Binding CurveAreaPoints}">
                                                    <Polygon.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#28EF4444" Offset="0"/>
                                                            <GradientStop Color="#0AEF4444" Offset="0.5"/>
                                                            <GradientStop Color="#00EF4444" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Polygon.Fill>
                                                </Polygon>

                                                <!-- Wide soft glow behind curve -->
                                                <Polyline Points="{Binding CurvePoints}" Stroke="#14EF4444"
                                                          StrokeThickness="16" StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                                <!-- Medium glow halo -->
                                                <Polyline Points="{Binding CurvePoints}" Stroke="#20EF4444"
                                                          StrokeThickness="8" StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                                <!-- Main curve line (gradient stroke) -->
                                                <Polyline Points="{Binding CurvePoints}" StrokeThickness="2.5"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                    <Polyline.Stroke>
                                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                            <GradientStop Color="#FFDC2626" Offset="0"/>
                                                            <GradientStop Color="#FFEF4444" Offset="0.25"/>
                                                            <GradientStop Color="#FFFF6666" Offset="0.55"/>
                                                            <GradientStop Color="#FFFFAAAA" Offset="0.8"/>
                                                            <GradientStop Color="#FFEF4444" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Polyline.Stroke>
                                                </Polyline>

                                                <!-- Bright highlight trace (inner glow) -->
                                                <Polyline Points="{Binding CurvePoints}" Stroke="#30FFFFFF"
                                                          StrokeThickness="1" StrokeLineJoin="Round"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                                <!-- Origin dot (bottom-left glow) -->
                                                <Ellipse Canvas.Left="-4" Canvas.Top="196" Width="8" Height="8"
                                                         Fill="#30EF4444"/>
                                                <Ellipse Canvas.Left="-2.5" Canvas.Top="197.5" Width="5" Height="5"
                                                         Fill="#FFEF4444"/>

                                                <!-- Axis tick marks — X axis -->
                                                <Line X1="100" Y1="198" X2="100" Y2="200" Stroke="#FF2A2A40" StrokeThickness="1"/>
                                                <Line X1="200" Y1="198" X2="200" Y2="200" Stroke="#FF2A2A40" StrokeThickness="1"/>
                                                <Line X1="300" Y1="198" X2="300" Y2="200" Stroke="#FF2A2A40" StrokeThickness="1"/>
                                                <!-- Axis tick marks — Y axis -->
                                                <Line X1="0" Y1="50"  X2="2" Y2="50"  Stroke="#FF2A2A40" StrokeThickness="1"/>
                                                <Line X1="0" Y1="100" X2="2" Y2="100" Stroke="#FF2A2A40" StrokeThickness="1"/>
                                                <Line X1="0" Y1="150" X2="2" Y2="150" Stroke="#FF2A2A40" StrokeThickness="1"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>

                                <!-- Curve Type Selector — pill-style row -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M1,6 Q6,0 11,6 Q6,12 1,6"
                                              Stroke="#FF52525b" StrokeThickness="1" Fill="Transparent"
                                              Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="Curve Type" Style="{StaticResource SettingLabel}" FontSize="12.5"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}"
                                              SelectedIndex="{Binding CurveTypeIndex}">
                                        <ComboBoxItem Content="Flat"/>
                                        <ComboBoxItem Content="Exponential"/>
                                        <ComboBoxItem Content="Adaptive"/>
                                        <ComboBoxItem Content="Logarithmic"/>
                                        <ComboBoxItem Content="S-Curve"/>
                                        <ComboBoxItem Content="Threshold"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══ SENSITIVITY VALUES ══ -->
                        <Border Style="{StaticResource CardPanelAccent}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Path Data="M6,0 A6,6 0 1,0 6,12 A6,6 0 1,0 6,0 M6,2 L6,6 L9,6"
                                          Stroke="{StaticResource AccentBrush}" StrokeThickness="1.3" Fill="Transparent"
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="SPEED CONTROL" Style="{StaticResource SectionTitle}" Margin="0"/>
                                </StackPanel>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Base Speed" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Overall mouse speed multiplier — higher = faster cursor" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                             Text="{Binding MouseSensitivityText, UpdateSourceTrigger=LostFocus}"
                                             PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Speed Ramp" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="How much faster the cursor gets when you move quickly" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                             Text="{Binding Acceleration, UpdateSourceTrigger=LostFocus}"
                                             PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Speed Ceiling" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Limits the max output speed — prevents overshooting targets" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                             Text="{Binding SensLimit, UpdateSourceTrigger=LostFocus}"
                                             PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                                </Grid>

                                <Separator Margin="0,8,0,8"/>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Horizontal Scale" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Adjusts left-right sensitivity independently" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                             Text="{Binding XAxisSensitivityText, UpdateSourceTrigger=LostFocus}"
                                             PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                                </Grid>

                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Vertical Scale" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Adjusts up-down sensitivity independently" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                             Text="{Binding YAxisSensitivityText, UpdateSourceTrigger=LostFocus}"
                                             PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══ RESOLUTION ══ -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DISPLAY RESOLUTION" Style="{StaticResource SectionTitle}"/>
                                    <Button Grid.Column="1" Style="{StaticResource OutlinedBtn}"
                                            Height="28" FontSize="11" Padding="10,0"
                                            Command="{Binding DetectDisplayCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M8,0 A8,8 0 1 0 8,16 A8,8 0 1 0 8,0 M13,13 L18,18"
                                                  Stroke="#FFa1a1aa" StrokeThickness="1.3" Fill="Transparent"
                                                  Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                            <TextBlock Text="Auto-Detect" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Width" Style="{StaticResource SettingLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource EditableValueBox}"
                                             Text="{Binding DisplayWidth, UpdateSourceTrigger=LostFocus}"
                                             PreviewTextInput="NumericOnly_PreviewTextInput"/>
                                </Grid>
                                <Slider Minimum="800" Maximum="3840" Value="{Binding DisplayWidth}" TickFrequency="10"/>

                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Height" Style="{StaticResource SettingLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource EditableValueBox}"
                                             Text="{Binding DisplayHeight, UpdateSourceTrigger=LostFocus}"
                                             PreviewTextInput="NumericOnly_PreviewTextInput"/>
                                </Grid>
                                <Slider Minimum="600" Maximum="2160" Value="{Binding DisplayHeight}" TickFrequency="10"/>

                                <Separator/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="EMULATOR RESOLUTION" Style="{StaticResource SectionTitle}"/>
                                    <Button Grid.Column="1" Style="{StaticResource OutlinedBtn}"
                                            Height="28" FontSize="11" Padding="10,0"
                                            Command="{Binding DetectEmulatorResolutionCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M8,0 A8,8 0 1 0 8,16 A8,8 0 1 0 8,0 M13,13 L18,18"
                                                  Stroke="#FFa1a1aa" StrokeThickness="1.3" Fill="Transparent"
                                                  Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                            <TextBlock Text="Auto-Detect" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Emulator resolution warning / status -->
                                <TextBlock Text="{Binding EmulatorResolutionStatus}"
                                           FontFamily="{StaticResource InterFont}" FontSize="10.5"
                                           Foreground="#FFf59e0b" TextWrapping="Wrap" Margin="0,2,0,4"
                                           Visibility="{Binding IsEmulatorWindowed, Converter={StaticResource BoolVis}}"/>

                                <!-- Source label -->
                                <TextBlock FontFamily="{StaticResource InterFont}" FontSize="10"
                                           Foreground="#FF71717a" Margin="0,0,0,4"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding EmulatorResolutionSource, Converter={StaticResource StringNotEmptyConverter}}">
                                    <Run Text="Source: "/><Run Text="{Binding EmulatorResolutionSource, Mode=OneWay}"/>
                                </TextBlock>

                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Width" Style="{StaticResource SettingLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource EditableValueBox}"
                                             Text="{Binding EmulatorWidth, UpdateSourceTrigger=LostFocus}"
                                             PreviewTextInput="NumericOnly_PreviewTextInput"/>
                                </Grid>
                                <Slider Minimum="640" Maximum="3840" Value="{Binding EmulatorWidth}" TickFrequency="10"/>

                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Height" Style="{StaticResource SettingLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource EditableValueBox}"
                                             Text="{Binding EmulatorHeight, UpdateSourceTrigger=LostFocus}"
                                             PreviewTextInput="NumericOnly_PreviewTextInput"/>
                                </Grid>
                                <Slider Minimum="480" Maximum="2160" Value="{Binding EmulatorHeight}" TickFrequency="10"/>
                            </StackPanel>
                        </Border>

                        <!-- ══ ACTIVATE / PAUSE ══ -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource PrimaryBtn}"
                                            Command="{Binding ActivateCommand}"
                                            IsEnabled="{Binding IsPaused}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M3,0 L12,6 L3,12 Z" Fill="White"
                                                  Width="10" Height="11" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="ACTIVATE" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource OutlinedBtn}"
                                            Command="{Binding PauseCommand}"
                                            IsEnabled="{Binding IsActive}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M1,0 L4,0 L4,12 L1,12 Z M8,0 L11,0 L11,12 L8,12 Z"
                                                  Fill="#FFa1a1aa" Width="10" Height="11" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="PAUSE" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Button Style="{StaticResource FlatBtn}" Margin="0,12,0,0"
                                        Command="{Binding GoToAdvancedCommand}" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Advanced Settings" Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="12"/>
                                        <Path Data="M2,0 L8,6 L2,12" Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.5" Fill="Transparent"
                                              Width="7" Height="10" Stretch="Uniform" Margin="6,1,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Tab 1: ADVANCED -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,10"
                              Visibility="{Binding SelectedTab, Converter={StaticResource BoolVis}, ConverterParameter=1}">
                    <StackPanel>
                        <!-- AIM PROCESSING -->
                        <Border Style="{StaticResource CardPanelAccent}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Path Data="M6,0 L7.5,4 L12,4 L8.5,7 L10,12 L6,9 L2,12 L3.5,7 L0,4 L4.5,4 Z"
                                          Fill="{StaticResource AccentBrush}" Width="13" Height="13"
                                          Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="MOTION PROCESSING" Style="{StaticResource SectionTitle}" Margin="0"/>
                                </StackPanel>
                                <TextBlock Text="Smart filters that adapt to your sensitivity for cleaner aim"
                                           Style="{StaticResource SettingDesc}" Margin="0,0,0,10"/>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Spray Stability" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Reduces shake during rapid fire — keeps crosshair steady" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                             Text="{Binding AdvRecoilControl, UpdateSourceTrigger=LostFocus}"
                                             PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Motion Smoothing" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Smooths cursor movement — removes jitter without adding delay" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                             Text="{Binding AdvSmoothStrength, UpdateSourceTrigger=LostFocus}"
                                             PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Tremor Filter" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Filters out hand tremor — keeps aim locked while holding still" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                             Text="{Binding AdvSteadyAim, UpdateSourceTrigger=LostFocus}"
                                             PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- AXIS FINE-TUNE -->
                        <Border Style="{StaticResource CardPanelAccent}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Path Data="M1,0 L11,0 M6,0 L6,12 M1,12 L11,12"
                                          Stroke="#FF8B5CF6" StrokeThickness="1.5" Fill="Transparent"
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="OUTPUT SCALING" Style="{StaticResource SectionTitle}" Margin="0"/>
                                </StackPanel>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Final Scale X" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Last-stage horizontal multiplier — fine-tune left-right output" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                             Text="{Binding PostScaleX, UpdateSourceTrigger=LostFocus}"
                                             PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Final Scale Y" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Last-stage vertical multiplier — fine-tune up-down output" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                             Text="{Binding PostScaleY, UpdateSourceTrigger=LostFocus}"
                                             PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- LOCK MODE / PER-MODE TUNING -->
                        <Border Style="{StaticResource CardPanelAccent}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Path Data="M6,0 L12,3 L12,9 L6,12 L0,9 L0,3 Z"
                                          Stroke="#FF06B6D4" StrokeThickness="1.5" Fill="Transparent"
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="MODE-SPECIFIC LOCK TUNING" Style="{StaticResource SectionTitle}" Margin="0"/>
                                </StackPanel>
                                <TextBlock Margin="0,0,0,10" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap"
                                          Text="User mode: Interception driver not installed, or your license has no kernel access. Kernel: driver installed and kernel access enabled on your key."/>

                                <!-- User path: no driver, or license denies kernel — User Lock Guard + User Accel only -->
                                <StackPanel Visibility="{Binding ShowUserModeLockTuning, Converter={StaticResource BoolVis}}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="User Lock Guard" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="How hard User Mode clamps lock-mode burst spikes" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectedIndex="{Binding UserLockStrictness}">
                                        <ComboBoxItem Content="Off"/>
                                        <ComboBoxItem Content="Normal"/>
                                        <ComboBoxItem Content="Strict"/>
                                        <ComboBoxItem Content="Ultra"/>
                                    </ComboBox>
                                </Grid>

                                <Separator Margin="0,8,0,8"/>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="User Accel X" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Horizontal response multiplier for User Mode tracking" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                             Text="{Binding UserAccelX, UpdateSourceTrigger=LostFocus}"
                                             PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="User Accel Y" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Vertical response multiplier for smoother drag in User Mode" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                             Text="{Binding UserAccelY, UpdateSourceTrigger=LostFocus}"
                                             PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                                </Grid>
                                </StackPanel>

                                <!-- Kernel path: Interception driver installed and license allows kernel — Kernel Lock Guard + Kernel Accel only -->
                                <StackPanel Visibility="{Binding ShowKernelModeLockTuning, Converter={StaticResource BoolVis}}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Kernel Lock Guard" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Kernel-specific anti-burst logic for locked games (recommended: Strict/Ultra)" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectedIndex="{Binding KernelLockStrictness}">
                                        <ComboBoxItem Content="Off"/>
                                        <ComboBoxItem Content="Normal"/>
                                        <ComboBoxItem Content="Strict"/>
                                        <ComboBoxItem Content="Ultra"/>
                                    </ComboBox>
                                </Grid>

                                <Separator Margin="0,8,0,8"/>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Kernel Accel X" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Horizontal response multiplier for kernel tracking logic" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                             Text="{Binding KernelAccelX, UpdateSourceTrigger=LostFocus}"
                                             PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                                </Grid>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Kernel Accel Y" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Vertical response multiplier for kernel drag precision" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                             Text="{Binding KernelAccelY, UpdateSourceTrigger=LostFocus}"
                                             PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                                </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Controls -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource PrimaryBtn}"
                                            Command="{Binding AdvancedPlayCommand}"
                                            IsEnabled="{Binding IsPaused}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M3,0 L12,6 L3,12 Z" Fill="White"
                                                  Width="10" Height="11" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="ACTIVATE" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource OutlinedBtn}"
                                            Command="{Binding AdvancedPauseCommand}"
                                            IsEnabled="{Binding IsActive}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M1,0 L4,0 L4,12 L1,12 Z M8,0 L11,0 L11,12 L8,12 Z"
                                                  Fill="#FFa1a1aa" Width="10" Height="11" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="PAUSE" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Button Style="{StaticResource FlatBtn}"
                                            Command="{Binding AdvancedResetCommand}" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M1,6 A5,5 0 1 1 6,11 M1,6 L1,2 M1,6 L5,6"
                                                  Stroke="#FF71717a" StrokeThickness="1.3" Fill="Transparent"
                                                  Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Reset All" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Button Style="{StaticResource FlatBtn}" Margin="0,8,0,0"
                                        Command="{Binding BackFromAdvancedCommand}" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M10,0 L4,6 L10,12" Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.5" Fill="Transparent"
                                              Width="7" Height="10" Stretch="Uniform" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Back to Sensitivity" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Tab 2: OPTIMIZE -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,10"
                              Visibility="{Binding SelectedTab, Converter={StaticResource BoolVis}, ConverterParameter=2}">
                    <StackPanel>
                        <!-- System Optimizations -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="SYSTEM OPTIMIZATION" Style="{StaticResource SectionTitle}"/>

                                <!-- Game Mode -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Game Mode Enhancer" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Game Mode ON, DVR OFF, GPU scheduling" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding OptGameMode}" VerticalAlignment="Center"/>
                                </Grid>

                                <Separator/>

                                <!-- NEW: Power Plan -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Power Plan Optimizer" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="High Performance, disable throttling" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding OptPowerPlan}" VerticalAlignment="Center"/>
                                </Grid>

                                <Separator/>

                                <!-- NEW: Audio Latency -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Audio Latency Optimizer" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Reduce audio delay for gaming" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding OptAudioLatency}" VerticalAlignment="Center"/>
                                </Grid>

                                <Separator/>

                                <!-- NEW: DPI Override -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DPI Scaling Override" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Fix blurry emulators, per-monitor DPI" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding OptDpiOverride}" VerticalAlignment="Center"/>
                                </Grid>

                                <Separator/>

                                <!-- NEW: Controller Optimizer -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Controller Input Optimizer" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Lower gamepad/controller latency" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding OptController}" VerticalAlignment="Center"/>
                                </Grid>

                                <Separator/>

                                <!-- NEW: Mouse Registry Optimizer -->
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Mouse Registry Optimizer" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Optimize all mouse/cursor registry for gaming" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding OptMouseRegistry}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Driver Status -->
                        <Border Style="{StaticResource CardPanel}">
                            <Grid>
                                <!-- Main content -->
                                <StackPanel>
                                    <TextBlock Text="DRIVER STATUS" Style="{StaticResource SectionTitle}"/>

                                    <Grid Margin="0,6,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Health indicator -->
                                        <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource OrangeBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DriversHealthy}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Grid.Column="1" Text="{Binding DriverStatus}"
                                                   Style="{StaticResource SettingLabel}" VerticalAlignment="Center"/>

                                        <!-- Mini loading spinner -->
                                        <Grid Grid.Column="2" Width="18" Height="18"
                                              Visibility="{Binding IsDriverLoading, Converter={StaticResource BoolVis}}">
                                            <Ellipse Width="18" Height="18" Stroke="#FF2A2A40" StrokeThickness="2"/>
                                            <Ellipse Width="18" Height="18" Stroke="{StaticResource AccentBrush}"
                                                     StrokeThickness="2" StrokeDashArray="1.5,3"
                                                     StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <RotateTransform x:Name="DriverSpinnerRotate" Angle="0"/>
                                                </Ellipse.RenderTransform>
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDriverLoading}" Value="True">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                             From="0" To="360" Duration="0:0:1"
                                                                                             RepeatBehavior="Forever"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                    </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource OutlinedBtn}"
                                            FontSize="11" Height="34" Padding="6,6"
                                            Command="{Binding CheckDriversCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M1,6 A5,5 0 1 1 6,11 M1,6 L1,2 M1,6 L5,6"
                                                  Stroke="#FFa1a1aa" StrokeThickness="1.3" Fill="Transparent"
                                                  Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0"/>
                                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource OutlinedBtn}"
                                            FontSize="11" Height="34" Padding="6,6"
                                            Command="{Binding ShowDriverReportCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M2,0 L8,0 L10,2 L10,12 L0,12 L0,0 Z M4,5 L8,5 M4,7 L8,7 M4,9 L6,9"
                                                  Stroke="#FFa1a1aa" StrokeThickness="1" Fill="Transparent"
                                                  Width="11" Height="12" Stretch="Uniform" Margin="0,0,4,0"/>
                                            <TextBlock Text="Report" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="4" Style="{StaticResource PrimaryBtn}"
                                            FontSize="11" Height="34" Padding="6,6"
                                            Command="{Binding RestartMouseDriverCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M5,0 L5,12 M5,0 L2,3 M5,0 L8,3"
                                                  Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                                                  Width="10" Height="12" Stretch="Uniform" Margin="0,0,4,0"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="180"/>
                                                </Path.RenderTransform>
                                            </Path>
                                            <TextBlock Text="Restart" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Interception Kernel Driver Install/Uninstall -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="KERNEL DRIVER" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Install or uninstall the Interception kernel driver. Requires Administrator privileges and a reboot to take effect."
                                           Style="{StaticResource SettingDesc}" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Status dot -->
                                    <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource OrangeBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InterceptionInstalled}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" Text="{Binding InterceptionStatusText}"
                                               Style="{StaticResource SettingLabel}" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource PrimaryBtn}"
                                            FontSize="11" Height="34" Padding="6,6"
                                            Command="{Binding InstallInterceptionCommand}"
                                            IsEnabled="{Binding CanInstallDriver}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M5,0 L5,10 M0,5 L10,5"
                                                  Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                                                  Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                            <TextBlock Text="Install Driver" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource OutlinedBtn}"
                                            FontSize="11" Height="34" Padding="6,6"
                                            Command="{Binding UninstallInterceptionCommand}"
                                            IsEnabled="{Binding CanUninstallDriver}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M0,5 L10,5"
                                                  Stroke="#FFa1a1aa" StrokeThickness="1.5" Fill="Transparent"
                                                  Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                            <TextBlock Text="Uninstall Driver" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Kernel Access Denied Warning -->
                                <Border Margin="0,8,0,0" Background="#20f87171" CornerRadius="8" Padding="10,8"
                                        Visibility="{Binding KernelAccessAllowed, Converter={StaticResource InvBoolVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M10,0 A10,10 0 1,0 10,20 A10,10 0 1,0 10,0 M10,5 L10,11 M10,14 L10,15"
                                              Stroke="#FFf87171" StrokeThickness="1.5" Fill="Transparent"
                                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding KernelAccessDeniedText}" FontSize="11" Foreground="#FFf87171"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Reset Mouse to Factory Defaults -->
                        <Border Style="{StaticResource CardPanelAccent}">
                            <StackPanel>
                                <TextBlock Text="MOUSE RESET" Style="{StaticResource SectionTitle}"/>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Reset Mouse to Factory Defaults" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Restores ALL mouse settings to Windows defaults — sensitivity, curves, acceleration, driver parameters. Removes any non-default registry values." Style="{StaticResource SettingDesc}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding ResetMouseDefaults}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Bypass (Firebase-controlled visibility) -->
                        <Border Style="{StaticResource CardPanel}"
                                Visibility="{Binding FeatureBypassVisible, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="BYPASS OPTIONS" Style="{StaticResource SectionTitle}"/>

                                <Grid Margin="0,3,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Enable Bypass" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Allow bypass operations below" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding BypassToggle}" VerticalAlignment="Center"/>
                                </Grid>

                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          SelectedIndex="{Binding SelectedBypassIndex}"
                                          IsEnabled="{Binding BypassToggle}">
                                    <ComboBoxItem Content="Complete Bypass"/>
                                    <ComboBoxItem Content="Journal Reset"/>
                                    <ComboBoxItem Content="Self-Destruct"/>
                                    <ComboBoxItem Content="Adv String Bypass"/>
                                    <ComboBoxItem Content="String Clearance"/>
                                    <ComboBoxItem Content="Standard Cleanup"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Tab 3: EXTRAS -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,10"
                              Visibility="{Binding SelectedTab, Converter={StaticResource BoolVis}, ConverterParameter=3}">
                    <StackPanel>
                        <!-- AI Mouse -->
                        <Border Style="{StaticResource CardPanelAccent}">
                            <StackPanel>
                                <TextBlock Text="AI MOUSE" Style="{StaticResource SectionTitle}"/>

                                <Grid Margin="0,3,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Enable AI Mouse" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="AI-powered mouse optimization" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding AiMouseEnabled}" VerticalAlignment="Center"/>
                                </Grid>

                                <ComboBox Style="{StaticResource DarkComboBox}" Margin="0,0,0,8"
                                          SelectedIndex="{Binding AiMouseIndex}"
                                          IsEnabled="{Binding AiMouseEnabled}">
                                    <ComboBoxItem Content="AI Mouse V1"/>
                                    <ComboBoxItem Content="AI Mouse V2"/>
                                    <ComboBoxItem Content="AI Mouse V3"/>
                                </ComboBox>

                                <Separator/>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="AI Click Optimization" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Optimize click registration" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding AiMouseClicking}" VerticalAlignment="Center"/>
                                </Grid>

                                <Separator/>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="AI Keyboard Optimization" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Reduce keyboard input delay" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding AiKeyboard}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Input Stabilizer -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="INPUT STABILIZER" Style="{StaticResource SectionTitle}"/>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Vertical Drift Correction" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Smooths out unwanted vertical mouse drift during sustained input for steadier control" Style="{StaticResource SettingDesc}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding AntiRecoil}" VerticalAlignment="Center"/>
                                </Grid>

                                <Separator/>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Linear Input Mode" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Disables Windows mouse acceleration for true 1:1 movement — what you move is what you get" Style="{StaticResource SettingDesc}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding NoAcceleration}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Window Options -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="WINDOW OPTIONS" Style="{StaticResource SectionTitle}"/>

                                <!-- Streamer Mode (Firebase-controlled) -->
                                <StackPanel Visibility="{Binding FeatureStreamerModeVisible, Converter={StaticResource BoolVis}}">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Streamer Mode" Style="{StaticResource SettingLabel}"/>
                                            <TextBlock Text="Hide from screen capture" Style="{StaticResource SettingDesc}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                      IsChecked="{Binding StreamerMode}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Separator/>
                                </StackPanel>

                                <!-- Form Bypass (Firebase-controlled) -->
                                <StackPanel Visibility="{Binding FeatureFormBypassVisible, Converter={StaticResource BoolVis}}">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Form Bypass" Style="{StaticResource SettingLabel}"/>
                                            <TextBlock Text="Hide from Alt+Tab switcher" Style="{StaticResource SettingDesc}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                      IsChecked="{Binding FormBypass}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Separator/>
                                </StackPanel>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Pin On Top" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Always on top of other windows" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding PinOnTop}" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Stop Network (Firebase-controlled) -->
                                <StackPanel Visibility="{Binding FeatureStopNetworkVisible, Converter={StaticResource BoolVis}}">
                                    <Separator/>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Stop Network" Style="{StaticResource SettingLabel}"/>
                                            <TextBlock Text="Block outbound connections" Style="{StaticResource SettingDesc}"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                      IsChecked="{Binding StopNetwork}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ═══ NEW: System Tools ═══ -->
                        <Border Style="{StaticResource CardPanelAccent}">
                            <StackPanel>
                                <TextBlock Text="SYSTEM TOOLS" Style="{StaticResource SectionTitle}"/>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- System Cleaner button -->
                                    <Button Grid.Column="0" Style="{StaticResource OutlinedBtn}"
                                            Height="42" FontSize="12"
                                            Command="{Binding RunSystemCleanerCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M3,6 L5,6 L5,20 A2,2 0 0,0 7,22 L17,22 A2,2 0 0,0 19,20 L19,6 L21,6 M8,6 L8,3 A1,1 0 0,1 9,2 L15,2 A1,1 0 0,1 16,3 L16,6 M10,11 L10,17 M14,11 L14,17"
                                                  Stroke="#FFa1a1aa" StrokeThickness="1.2" Fill="Transparent"
                                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="System Clean" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Privacy Mode button -->
                                    <Button Grid.Column="2" Style="{StaticResource OutlinedBtn}"
                                            Height="42" FontSize="12"
                                            Command="{Binding RunPrivacyCleanCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M12,1 L3,5 L3,11 C3,16.55 6.84,21.74 12,23 C17.16,21.74 21,16.55 21,11 L21,5 Z M10,17 L6,13 L7.41,11.59 L10,14.17 L16.59,7.58 L18,9 Z"
                                                  Fill="#FFa1a1aa" Width="14" Height="14" Stretch="Uniform"
                                                  Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Privacy Mode" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ═══ NEW: System Info ═══ -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="SYSTEM INFORMATION" Style="{StaticResource SectionTitle}"/>

                                <!-- CPU -->
                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#10FFFFFF" CornerRadius="6" Width="28" Height="28">
                                        <Path Data="M9,2 L15,2 L15,4 L18,4 L18,8 L20,8 L20,16 L18,16 L18,20 L15,20 L15,22 L9,22 L9,20 L6,20 L6,16 L4,16 L4,8 L6,8 L6,4 L9,4 Z"
                                              Stroke="{StaticResource AccentBrush}" StrokeThickness="1" Fill="Transparent"
                                              Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="CPU" FontSize="10" FontWeight="SemiBold" Foreground="#FF52525b"/>
                                        <TextBlock Text="{Binding SysInfoCpu}" FontSize="11" Foreground="#FFa1a1aa"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>

                                <Separator/>

                                <!-- RAM -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#10FFFFFF" CornerRadius="6" Width="28" Height="28">
                                        <Path Data="M2,4 L22,4 L22,18 L2,18 Z M6,4 L6,18 M18,4 L18,18 M10,4 L10,18 M14,4 L14,18"
                                              Stroke="{StaticResource PurpleBrush}" StrokeThickness="1" Fill="Transparent"
                                              Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="RAM" FontSize="10" FontWeight="SemiBold" Foreground="#FF52525b"/>
                                        <TextBlock Text="{Binding SysInfoRam}" FontSize="11" Foreground="#FFa1a1aa"/>
                                    </StackPanel>
                                </Grid>

                                <Separator/>

                                <!-- GPU -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#10FFFFFF" CornerRadius="6" Width="28" Height="28">
                                        <Path Data="M2,6 L22,6 L22,20 L2,20 Z M6,20 L6,22 M18,20 L18,22 M4,22 L8,22 M16,22 L20,22 M6,10 L10,10 L10,16 L6,16 Z"
                                              Stroke="{StaticResource GreenBrush}" StrokeThickness="1" Fill="Transparent"
                                              Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="GPU" FontSize="10" FontWeight="SemiBold" Foreground="#FF52525b"/>
                                        <TextBlock Text="{Binding SysInfoGpu}" FontSize="11" Foreground="#FFa1a1aa"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>

                                <Separator/>

                                <!-- OS -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#10FFFFFF" CornerRadius="6" Width="28" Height="28">
                                        <Path Data="M3,3 L11,3 L11,11 L3,11 Z M13,3 L21,3 L21,11 L13,11 Z M3,13 L11,13 L11,21 L3,21 Z M13,13 L21,13 L21,21 L13,21 Z"
                                              Stroke="{StaticResource BlueBrush}" StrokeThickness="1" Fill="Transparent"
                                              Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="OS" FontSize="10" FontWeight="SemiBold" Foreground="#FF52525b"/>
                                        <TextBlock Text="{Binding SysInfoOs}" FontSize="11" Foreground="#FFa1a1aa"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

                <!-- Tab 4: SETTINGS -->
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Padding="18,10"
                              Visibility="{Binding SelectedTab, Converter={StaticResource BoolVis}, ConverterParameter=4}">
                    <StackPanel>

                        <!-- General Settings -->
                        <Border Style="{StaticResource CardPanelAccent}">
                            <StackPanel>
                                <TextBlock Text="GENERAL" Style="{StaticResource SectionTitle}"/>

                                <!-- Auto Save -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Auto Save" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Automatically save all settings on every change" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding AutoSaveEnabled}" VerticalAlignment="Center"/>
                                </Grid>

                                <Separator/>

                                <!-- Persist Across Apps -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Persist Across Apps" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Keep sensitivity active when switching windows" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding PersistAcrossApps}" VerticalAlignment="Center"/>
                                </Grid>

                                <Separator/>

                                <!-- Always on Top -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Always on Top" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Keep LegitX V2 window above all other windows" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding AlwaysOnTop}" VerticalAlignment="Center"/>
                                </Grid>

                                <Separator/>

                                <!-- Keyboard Shortcuts -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Keyboard Shortcuts" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Configure the toggle visibility hotkey" Style="{StaticResource SettingDesc}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource OutlinedBtn}"
                                            Command="{Binding OpenShortcutSettingsCommand}"
                                            Height="30" Padding="12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M1,1 L15,1 L15,5 L9,5 L9,9 L15,9 L15,11 L1,11 Z M3,3 L5,3 L5,5 L3,5 Z M7,3 L9,3 L9,5 L7,5 Z M11,3 L13,3 L13,5 L11,5 Z M3,7 L11,7 L11,9 L3,9 Z"
                                                  Fill="#FF71717a" Width="13" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Edit" FontSize="11.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Emulator Detection -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="EMULATOR DETECTION" Style="{StaticResource SectionTitle}"/>

                                <!-- Auto-Detect Resolution -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Auto-Detect Resolution" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Automatically detect emulator window size, fullscreen, and resolution when it starts" Style="{StaticResource SettingDesc}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding AutoDetectEmulatorRes}" VerticalAlignment="Center"/>
                                </Grid>

                                <Separator/>

                                <!-- Live Sync Resolution -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Live Resolution Sync" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Continuously update resolution if the emulator window is resized or switched to fullscreen" Style="{StaticResource SettingDesc}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding LiveResolutionSync}" VerticalAlignment="Center"/>
                                </Grid>

                                <Separator/>

                                <!-- Current Detection Status -->
                                <StackPanel Margin="0,6,0,2">
                                    <TextBlock Text="Current Status" Style="{StaticResource SettingLabel}" Margin="0,0,0,4"/>
                                    <Border Background="#08FFFFFF" CornerRadius="8" Padding="12,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding EmulatorStatus}" Foreground="#FFa1a1aa" FontSize="11.5" TextWrapping="Wrap"/>
                                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#FF71717a" TextWrapping="Wrap"
                                                       Visibility="{Binding EmulatorResolutionSource, Converter={StaticResource StringNotEmptyConverter}}">
                                                <Run Text="Resolution: "/><Run Text="{Binding EmulatorWidth, Mode=OneWay}"/><Run Text=" × "/><Run Text="{Binding EmulatorHeight, Mode=OneWay}"/>
                                                <Run Text="  |  Source: "/><Run Text="{Binding EmulatorResolutionSource, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding EmulatorResolutionStatus}" FontSize="11"
                                                       Foreground="#FFf59e0b" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding EmulatorResolutionStatus, Converter={StaticResource StringNotEmptyConverter}}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Device & Emulator Selection -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DEVICE &amp; EMULATOR" Style="{StaticResource SectionTitle}"/>
                                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" ToolTip="Refresh devices"
                                            Command="{Binding RefreshDevicesCommand}" Width="28" Height="28">
                                        <Path Data="M1,6 A5,5 0 1 1 6,11 M1,6 L1,2 M1,6 L5,6"
                                              Stroke="#FF71717a" StrokeThickness="1.3" Fill="Transparent"
                                              Width="11" Height="11" Stretch="Uniform"/>
                                    </Button>
                                </Grid>

                                <!-- Mouse Device -->
                                <TextBlock Text="Mouse Device" Style="{StaticResource SettingLabel}" Margin="0,4,0,4"/>
                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding MouseDevices}"
                                          SelectedIndex="{Binding SelectedMouseIndex}"/>

                                <!-- Keyboard Device -->
                                <TextBlock Text="Keyboard Device" Style="{StaticResource SettingLabel}" Margin="0,8,0,4"/>
                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding KeyboardDevices}"
                                          SelectedIndex="{Binding SelectedKeyboardIndex}"/>

                                <Separator/>

                                <!-- Emulator Selection -->
                                <TextBlock Text="Emulator" Style="{StaticResource SettingLabel}" Margin="0,2,0,4"/>
                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding SupportedEmulators}"
                                          SelectedIndex="{Binding SelectedEmulatorIndex}"/>

                                <!-- Emulator Status -->
                                <Border Margin="0,10,0,0" Background="#08FFFFFF" CornerRadius="8" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#FF3f3f46"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEmulatorConnected}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEmulatorBlocked}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Grid.Column="1" Text="{Binding EmulatorStatus}" TextWrapping="Wrap"
                                                   FontSize="11" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FF71717a"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEmulatorConnected}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEmulatorBlocked}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- ═══ Emulator Info Panel (shown when connected) ═══ -->
                                <Border Margin="0,8,0,0" Background="#06FFFFFF" CornerRadius="8" Padding="12,10"
                                        Visibility="{Binding IsEmulatorConnected, Converter={StaticResource BoolVis}}">
                                    <StackPanel>
                                        <TextBlock Text="EMULATOR DETAILS" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="#FF52525b" Margin="0,0,0,8"
                                                   FontFamily="{StaticResource MonoFont}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Process" FontSize="10.5" Foreground="#FF52525b"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding EmuInfoProcess}" FontSize="10.5" Foreground="#FFa1a1aa" FontFamily="{StaticResource MonoFont}"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="PID" FontSize="10.5" Foreground="#FF52525b" Margin="0,2,0,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding EmuInfoPID}" FontSize="10.5" Foreground="#FFa1a1aa" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Memory" FontSize="10.5" Foreground="#FF52525b" Margin="0,2,0,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding EmuInfoMemory}" FontSize="10.5" Foreground="#FFa1a1aa" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Engine" FontSize="10.5" Foreground="#FF52525b" Margin="0,2,0,0"/>
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding EmuInfoEngine}" FontSize="10.5" Foreground="#FFa1a1aa" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Version" FontSize="10.5" Foreground="#FF52525b" Margin="0,2,0,0"/>
                                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding EmuInfoVersion}" FontSize="10.5" Foreground="#FFa1a1aa" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0"/>

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="CPU Alloc" FontSize="10.5" Foreground="#FF52525b" Margin="0,2,0,0"/>
                                            <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding EmuInfoCPU}" FontSize="10.5" Foreground="#FFa1a1aa" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0"/>

                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="RAM Alloc" FontSize="10.5" Foreground="#FF52525b" Margin="0,2,0,0"/>
                                            <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding EmuInfoRAM}" FontSize="10.5" Foreground="#FFa1a1aa" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0"/>

                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="FPS Cap" FontSize="10.5" Foreground="#FF52525b" Margin="0,2,0,0"/>
                                            <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding EmuInfoFPS}" FontSize="10.5" Foreground="#FFa1a1aa" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0"/>

                                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Uptime" FontSize="10.5" Foreground="#FF52525b" Margin="0,2,0,0"/>
                                            <TextBlock Grid.Row="8" Grid.Column="2" Text="{Binding EmuInfoUptime}" FontSize="10.5" Foreground="#FFa1a1aa" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0"/>
                                        </Grid>

                                        <!-- Optimize Button -->
                                        <Button Style="{StaticResource PrimaryBtn}" Margin="0,12,0,0"
                                                Command="{Binding OptimizeEmulatorConnectionCommand}"
                                                HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Path Data="M10,0 L12,7 L20,7 L14,12 L16,20 L10,15 L4,20 L6,12 L0,7 L8,7 Z"
                                                      Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="BOOST EMULATOR" VerticalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Save / Reset -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="DATA" Style="{StaticResource SectionTitle}"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource PrimaryBtn}"
                                            Command="{Binding SaveCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M3,1 L3,5 L9,5 L9,1 M2,0 L10,0 L12,2 L12,12 L0,12 L0,0 Z M4,8 L8,8 L8,12 L4,12 Z"
                                                  Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="SAVE ALL" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource OutlinedBtn}"
                                            Command="{Binding ResetCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M1,6 A5,5 0 1 1 6,11 M1,6 L1,2 M1,6 L5,6"
                                                  Stroke="#FFa1a1aa" StrokeThickness="1.3" Fill="Transparent"
                                                  Width="11" Height="11" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="RESET ALL" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Import / Export Settings -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="IMPORT / EXPORT" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Share your Sensitivity &amp; Advanced settings with others. Export saves all tuning values to a .legitx file that anyone can import."
                                           Style="{StaticResource SettingDesc}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource PrimaryBtn}"
                                            Command="{Binding ExportSettingsCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M6,0 L6,8 M2,5 L6,9 L10,5 M0,11 L0,13 L12,13 L12,11"
                                                  Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                                                  Width="11" Height="11" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="EXPORT" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource OutlinedBtn}"
                                            Command="{Binding ImportSettingsCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M6,9 L6,1 M2,4 L6,0 L10,4 M0,11 L0,13 L12,13 L12,11"
                                                  Stroke="#FFa1a1aa" StrokeThickness="1.5" Fill="Transparent"
                                                  Width="11" Height="11" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="IMPORT" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- About -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="ABOUT" Style="{StaticResource SectionTitle}"/>
                                <TextBlock FontSize="11.5" Foreground="#FF71717a" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="LegitX V2 — Precision Mouse Control for Android Emulators. Built for competitive mobile gamers who demand pixel-perfect aim."/>
                                <TextBlock FontSize="10.5" Foreground="#FF52525b" Margin="0,8,0,0"
                                           Text="© 2026 LegitX. All rights reserved."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            <!-- ╔══════════════════════════════════════════════════╗
                 ║                 STATUS BAR                        ║
                 ╚══════════════════════════════════════════════════╝ -->
            <Border Grid.Row="5" Padding="20,10" Background="#08FFFFFF" CornerRadius="0,0,16,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <!-- Status dot with glow effect -->
                        <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse Width="14" Height="14" Opacity="0.3">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse Width="8" Height="8">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FF3f3f46"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource GreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                        <TextBlock VerticalAlignment="Center" FontSize="11.5" FontWeight="Medium">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Inactive"/>
                                    <Setter Property="Foreground" Value="#FF52525b"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Text" Value="Active"/>
                                            <Setter Property="Foreground" Value="{StaticResource GreenBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Hook mode indicator (center) -->
                    <Border Grid.Column="1" CornerRadius="6" Padding="8,3" Margin="0,0,8,0"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            ToolTip="Shows whether the engine is using the kernel-level Interception driver or the user-mode WH_MOUSE_LL hook">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Background" Value="#12FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding HookModeText}" FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FF52525b"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HookModeText}" Value="KERNEL MODE">
                                            <Setter Property="Foreground" Value="#FF22d3ee"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HookModeText}" Value="USER MODE">
                                            <Setter Property="Foreground" Value="#FFfbbf24"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Border Grid.Column="2" Background="#0AFFFFFF" CornerRadius="6" Padding="8,4"
                            Cursor="Hand" MouseLeftButtonDown="ShortcutBadge_Click"
                            ToolTip="Click to edit shortcuts">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#12FFFFFF" CornerRadius="3" Padding="5,2" Margin="0,0,6,0">
                                <TextBlock x:Name="ShortcutKeyBadge" Text="INS" FontSize="9" FontWeight="Bold"
                                           Foreground="#FF52525b" FontFamily="{StaticResource MonoFont}"/>
                            </Border>
                            <TextBlock Text="toggle visibility" FontSize="10"
                                       Foreground="#FF3f3f46" VerticalAlignment="Center"/>
                            <Path Data="M6,0 A6,6 0 1,0 6,12 A6,6 0 1,0 6,0 M6,3 A3,3 0 1,0 6,9 A3,3 0 1,0 6,3 M6,0 L6,-1.5 M6,12 L6,13.5 M0,6 L-1.5,6 M12,6 L13.5,6"
                                  Stroke="#FF3f3f46" StrokeThickness="0.8" Fill="Transparent"
                                  Width="10" Height="10" Stretch="Uniform" Margin="8,0,0,0"
                                  VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══════════════ LOADING OVERLAY ═══════════════ -->
            <Border x:Name="LoadingOverlay" Grid.RowSpan="6" Panel.ZIndex="999"
                    Background="#CC09090b" CornerRadius="16"
                    Visibility="Collapsed" IsHitTestVisible="True">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Spinning ring -->
                    <Border x:Name="SpinnerRing" Width="48" Height="48"
                            BorderThickness="3"
                            CornerRadius="24" Background="Transparent"
                            RenderTransformOrigin="0.5,0.5"
                            Opacity="0.9">
                        <Border.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                        </Border.RenderTransform>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFa855f7" Offset="0"/>
                                <GradientStop Color="#FF6366f1" Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                    </Border>
                    <TextBlock x:Name="LoadingText" Text="Applying…"
                               FontSize="13" FontWeight="Medium"
                               Foreground="#FFd4d4d8"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"
                               FontFamily="{StaticResource InterFont}"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
